# Check the enlarged reconstruction and mesh-forcing Jacobian in 3D.
# The phase varies in all three directions and the boundary motion deforms the mesh.
subsection Dimension
  set dimension = 3
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results = false
end

subsection Mesh
  set dealii preset mesh     = rectangle
  set dealii mesh parameters = 2, 2, 2 : 0., 0., 0. : 1., 1., 1. : true
  set refinement level       = 1
end


subsection Time integration
  set dt               = 0.01
  set t_initial        = 0
  set t_end            = 0.02
  set scheme           = BDF1
end

subsection Nonlinear solver
  set tolerance            = 1e-10
  set divergence_tolerance = 1e+4
  set max_iterations       = 40
  set enable_line_search   = true
  set analytic_jacobian    = true

  set compare jacobian matrix with finite differences = true
  set analytical_jacobian_absolute_tolerance = 1e-6
  set analytical_jacobian_relative_tolerance = 1e-6
end

subsection Linear solver
  subsection main physics
    set verbosity      = quiet
    set method         = direct_mumps
    set reuse          = true
  end
end

subsection FiniteElements
  set Velocity degree      = 2
  set Pressure degree      = 1
  set Mesh position degree = 1
  set Tracer degree        = 1
  set Potential degree     = 1
end

subsection Physical properties
  set number of fluids = 2
  subsection Fluid 0
    set density             = 2
    set kinematic viscosity = 0.01
  end
  subsection Fluid 1
    set density             = 1
    set kinematic viscosity = 0.01
  end
  set number of pseudosolids = 1
  subsection Pseudosolid 0
    subsection lame lambda
      set Function expression = 1
    end
    subsection lame mu
      set Function expression = 1
    end
  end
  set body force = 0, 0, -0.981
end

subsection Cahn Hilliard
  subsection mobility
    set constant value = 6.1e-6
  end
  set surface tension       = 24.5
  set interface thickness   = 1
  set enable tracer limiter = false

  set psi interface width factor = 2
  set psi mu correction factor = 0.3

  set mff source term                        = chns form
  set mff physics compression factor         = 0.5
  set mff enlarged compression factor        = 0.5
  set mff transport factor                   = 0.1
  set mff regularization gamma               = 0.5
  set mff enlarged lobe position exponent = 0.7
end

subsection Initial conditions
  subsection velocity
    set Function expression = 0; 0; 0
  end
  subsection cahn hilliard tracer
    set Function expression = -0.3 + 0.2*x*y + 0.1*y*z + 0.15*x*z
  end
end

subsection Fluid boundary conditions
  set number = 6
  set fix pressure constant = true
  set enforce zero mean pressure = false
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = no_slip
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = no_slip
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = no_slip
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = no_slip
  end
  subsection boundary 4
    set id = 4
    set name = z_min
    set type = no_slip
  end
  subsection boundary 5
    set id = 5
    set name = z_max
    set type = no_slip
  end
end

subsection Pseudosolid boundary conditions
  set number = 6
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
  subsection boundary 4
    set id = 4
    set name = z_min
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
  subsection boundary 5
    set id = 5
    set name = z_max
    set type = input_function
    subsection x
      set Function expression = x + 0.03*sin(2*pi*t)*x*(1-x)
    end
    subsection y
      set Function expression = y + 0.03*sin(2*pi*t)*y*(1-y)
    end
    subsection z
      set Function expression = z + 0.03*sin(2*pi*t)*z*(1-z)
    end
  end
end

subsection CahnHilliard boundary conditions
  set number = 6
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = no_flux
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = no_flux
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = no_flux
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = no_flux
  end
  subsection boundary 4
    set id = 4
    set name = z_min
    set type = no_flux
  end
  subsection boundary 5
    set id = 5
    set name = z_max
    set type = no_flux
  end
end
