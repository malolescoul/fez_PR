# Conservative boundary fluxes with a moving mesh and nonzero u-w.
# The right wall prescribes u only; its vertical velocity and position are free.
# Includes adaptive mobility, profile correction, SUPG/PSPG and tracer SUPG.
subsection Dimension
  set dimension = 2
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results = false
  set output directory  = ./
  set output prefix     = solution
end

subsection Mesh
  set dealii preset mesh     = rectangle
  set dealii mesh parameters = 2, 2 : 0., 0. : 1., 1. : true
  set refinement level       = 1
end

subsection Time integration
  set verbosity        = quiet
  set dt               = 0.01
  set t_initial        = 0
  set t_end            = 0.02
  set scheme           = BDF2
  set bdf start method = BDF1
end

subsection Nonlinear solver
 set compare jacobian matrix with finite differences = true
 set analytical_jacobian_absolute_tolerance = 1e-4
 set analytical_jacobian_relative_tolerance = 1e-4
  set verbosity            = verbose
  set tolerance            = 1e-9
  set divergence_tolerance = 1e+4
  set max_iterations       = 50
  set enable_line_search   = true
  set analytic_jacobian    = true
end

subsection Linear solver
  subsection main physics
    set verbosity = quiet
    set method    = direct_mumps
    set reuse     = true
  end
end

subsection FiniteElements
  set Velocity degree  = 2
  set Pressure degree  = 1
  set Tracer degree    = 2
  set Potential degree = 2
  set Mesh position degree = 2
end

subsection Stabilization
  set enable supg        = true
  set enable tracer supg = true
end

subsection Physical properties
  set number of fluids = 2
  subsection Fluid 0
    set density             = 1.1
    set kinematic viscosity = 2
  end
  subsection Fluid 1
    set density             = 1
    set kinematic viscosity = 1
  end
  set number of pseudosolids = 1
  subsection Pseudosolid 0
    subsection lame lambda
      set Function expression = 1
    end
    subsection lame mu
      set Function expression = 1
    end
  end
  set body force = 0, -9.81
end

subsection Cahn Hilliard
 set enable energy consistent formulation = true
  set psi interface width factor = 1.5
  set psi mu correction factor = 0.3
  set enable profile correction = true
  set profile correction strength = 0.6
  subsection mobility
    set model = Adaptive normal velocity
    set scaling factor = 0.4
    set mobility regularization = 0.001
    set Function expression = 0.1*(1-x*x)^2
  end
  set surface tension     = 1
  set interface thickness = 0.3
end

subsection Initial conditions
  subsection velocity
    set Function expression = 0.2; 0.03*sin(pi*x)*sin(pi*y)
  end
  subsection cahn hilliard tracer
    set Function expression = 0.2+0.1*cos(2*pi*x)*cos(2*pi*y)
  end
end

subsection Fluid boundary conditions
  set number = 4
  set fix pressure constant      = true
  set enforce zero mean pressure = false
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = input_function
    subsection u
      set Function expression = 0.15+0.05*cos(t)
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set constrain_v = false
    set type = input_function
    subsection u
      set Function expression = 0.15+0.05*cos(t)
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = input_function
    subsection u
      set Function expression = 0.15+0.05*cos(t)
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = input_function
    subsection u
      set Function expression = 0.15+0.05*cos(t)
    end
    subsection v
      set Function expression = 0
    end
  end
end

subsection Pseudosolid boundary conditions
  set number = 4
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = input_function
    subsection x
      set Function expression = x+0.05*sin(t)
    end
    subsection y
      set Function expression = y
    end
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = input_function
    subsection x
      set Function expression = x+0.05*sin(t)
    end
    subsection y
      set type = no_flux
    end
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = input_function
    subsection x
      set Function expression = x+0.05*sin(t)
    end
    subsection y
      set Function expression = y
    end
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = input_function
    subsection x
      set Function expression = x+0.05*sin(t)
    end
    subsection y
      set Function expression = y
    end
  end
end

subsection CahnHilliard boundary conditions
  set number = 4
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = no_flux
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set type = no_flux
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = no_flux
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = no_flux
  end
end

subsection Debug
  set verbosity            = verbose
  set apply exact solution = false
end

subsection Postprocessing
  subsection chns conservation
    set enable = true
    set write results = true
    set precision = 14
  end
  subsection chns energy
    set enable = true
    set write results = true
    set precision = 14
  end
end
