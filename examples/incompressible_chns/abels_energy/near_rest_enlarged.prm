# Reproducer of the existing discontinuity in the SUPG length at |u-w|^2=1e-12.
# This run may fail nonlinear convergence near t=0.004; see AUDIT.md.
subsection Dimension
 set dimension = 2
end
subsection Timer
 set enable timer = false
end
subsection Mesh
 set dealii preset mesh = rectangle
 set dealii mesh parameters = 4, 4 : 0., 0. : 1., 1. : true
 set refinement level = 1
end
subsection Time integration
 set t_initial = 0
 set scheme = BDF2
 set bdf start method = BDF1
 set dt = 0.001
 set t_end = 0.006
end
subsection Nonlinear solver
 set tolerance = 1e-11
 set max_iterations = 40
 set enable_line_search = true
end
subsection Linear solver
 subsection main physics
  set method = direct_mumps
  set verbosity = quiet
 end
end
subsection FiniteElements
 set Velocity degree = 2
 set Pressure degree = 1
 set Tracer degree = 2
 set Potential degree = 2
end
subsection Physical properties
 set number of fluids = 2
 subsection Fluid 0
  set density = 2
  set kinematic viscosity = 0.1
 end
 subsection Fluid 1
  set density = 1
  set kinematic viscosity = 0.1
 end
 set body force = 0, 0
end
subsection Cahn Hilliard
 set enable energy consistent formulation = true
 set surface tension = 1
 set interface thickness = 0.1
 subsection mobility
  set model = constant
  set constant value = 0.001
 end
end
subsection Stabilization
 set enable supg = true
 set enable tracer supg = true
end
subsection Initial conditions
 subsection velocity
  set Function expression = 0; 0
 end
 subsection cahn hilliard tracer
  set Function expression = 0.5*cos(pi*x)*cos(pi*y)
 end
end
subsection Fluid boundary conditions
 set number = 4
 set fix pressure constant = true
 set enforce zero mean pressure = false
 subsection boundary 0
  set id = 0
  set name = x_min
  set type = no_slip
 end
 subsection boundary 1
  set id = 1
  set name = x_max
  set type = no_slip
 end
 subsection boundary 2
  set id = 2
  set name = y_min
  set type = no_slip
 end
 subsection boundary 3
  set id = 3
  set name = y_max
  set type = no_slip
 end
end
subsection CahnHilliard boundary conditions
 set number = 4
 subsection boundary 0
  set id = 0
  set name = x_min
  set type = no_flux
 end
 subsection boundary 1
  set id = 1
  set name = x_max
  set type = no_flux
 end
 subsection boundary 2
  set id = 2
  set name = y_min
  set type = no_flux
 end
 subsection boundary 3
  set id = 3
  set name = y_max
  set type = no_flux
 end
end
subsection Output
 set write vtu results = false
 set output directory = ./
end
subsection Postprocessing
 subsection chns conservation
  set enable = true
  set write results = true
  set precision = 14
 end
 subsection chns energy
  set enable = true
  set write results = true
  set precision = 14
 end
 subsection chns phase energy
  set enable = true
  set write results = true
  set precision = 14
 end
 subsection chns stabilization energy
  set enable = true
  set write results = true
  set precision = 14
 end
end

subsection FiniteElements
 set Mesh position degree = 2
end
subsection Physical properties
 set number of pseudosolids = 1
 subsection Pseudosolid 0
  subsection lame lambda
   set Function expression = 1
  end
  subsection lame mu
   set Function expression = 1
  end
 end
end
subsection Cahn Hilliard
 set mff source term = chns form
 set mff physics compression factor = 0.05
 set mff enlarged compression factor = 0.05
end
subsection Pseudosolid boundary conditions
 set number = 4
 subsection boundary 0
 set id = 0
 set name = x_min
 set type = fixed
 end
 subsection boundary 1
 set id = 1
 set name = x_max
 set type = fixed
 end
 subsection boundary 2
 set id = 2
 set name = y_min
 set type = fixed
 end
 subsection boundary 3
 set id = 3
 set name = y_max
 set type = fixed
 end
end
